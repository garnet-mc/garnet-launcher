{
  "schemaVersion": 1,
  "id": "garnet-client",
  "version": "${version}",
  "name": "Garnet Client",
  "description": "Garnet Render (our own shader pipeline), proximity voice chat and server mod sync for Garnet servers.",
  "authors": [
    "Garnet"
  ],
  "contact": {
    "homepage": "https://github.com/garnet-mc/garnet-launcher",
    "sources": "https://github.com/garnet-mc/garnet-launcher"
  },
  "license": "MIT",
  "icon": "assets/garnet-client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.garnetmc.client.GarnetClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16",
    "fabric-api": "*",
    "minecraft": ">=26.3",
    "java": ">=21"
  },
  "mixins": [
    "garnet-client.mixins.json"
  ]
}
